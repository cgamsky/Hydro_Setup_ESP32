# Gitignore settings for ESPHome
# This is an example and may include too much for your use-case.
# You can modify this file to suit your needs.
/.esphome/
/.vscode/
/secrets.yaml
/proxmox-inventory.txt
/proxmox-backup-check.txt
/Promox_server_details.pdf
*.log

# SSH keys - never commit private or public keys
/key
/key.pub
/vskey
/vskey.pub
*.pem
id_rsa
id_ed25519
